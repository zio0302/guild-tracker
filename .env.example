# ==========================================
# 메이플키우기 길드 트래커 환경변수
# ==========================================
# 이 파일을 .env.local 로 복사하여 사용하세요
# $ copy .env.example .env.local

# ──────────────────────────────────────────
# Supabase 연결 정보
# (Supabase 콘솔 > Settings > Database > Connection string > Transaction pooler)
# ──────────────────────────────────────────
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# ──────────────────────────────────────────
# 앱 설정
# ──────────────────────────────────────────
# 추적할 길드 이름 (mgf.gg에 등록된 이름 그대로)
GUILD_NAME=바부들

# Vercel Cron 보안 시크릿 (임의의 랜덤 문자열로 설정)
# Cron 요청이 외부에서 임의로 실행되지 않도록 보호
CRON_SECRET=your-secret-key-here
